# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push (VAPID) — npx web-push generate-vapid-keys 로 생성
# Vercel: Settings → Environment Variables → Production/Preview 모두 설정 후 Redeploy
VITE_VAPID_PUBLIC_KEY=

# 지티(GiTi) AI — Anthropic Claude
# Vercel: VITE_ANTHROPIC_API_KEY (Production/Preview) 설정 후 Redeploy
# 주의: VITE_ 접두사는 브라우저에 노출됩니다. 키 사용량·제한에 유의하세요.
VITE_ANTHROPIC_API_KEY=

# Edge Function 시크릿 (Supabase Dashboard → Edge Functions → Secrets)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@gts.kr
# ANTHROPIC_API_KEY=                 # 지티 리포트 Claude 분석 (서버)
# GITI_APPS_SCRIPT_URL=              # Apps Script 웹앱 URL (.../exec)
# GITI_APPS_SCRIPT_SECRET=           # Apps Script SCRIPT_SECRET 과 동일 (선택)
# GITI_REPORT_FOLDER_ID=1uKmiizsoyteFx1wqOo__YwdT3AXwe-B0
# SUPER_ADMIN_ID=                    # 푸시 수신자 (VITE_SUPER_ADMIN_ID 와 동일)
